# Keep hashed text artifacts byte-identical in Windows and Unix checkouts.
* text=auto eol=lf
# Preserve unmodified third-party font software and full upstream notices.
src/elvia/web/*.woff2 -text
src/elvia/web/LICENSE-*.txt -text whitespace=-blank-at-eol
# Preserve every pinned upstream KaTeX byte and its LF asset manifest.
src/elvia/web/vendor/katex/** -text whitespace=-blank-at-eol
# Preserve actual captured stdout bytes, including the original platform newline.
studies/ten-paper-pilot/evidence/*/output.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
